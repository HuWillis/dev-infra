# Generated local credentials belong only in .env. Run: .\infra.ps1 Init
DOCKER_PLATFORM=linux/amd64
MYSQL_ROOT_PASSWORD=GENERATE
MYSQL_USER=dev
MYSQL_PASSWORD=GENERATE
REDIS_PASSWORD=GENERATE
RABBITMQ_DEFAULT_USER=dev
RABBITMQ_DEFAULT_PASS=GENERATE
MINIO_ROOT_USER=devminio
MINIO_ROOT_PASSWORD=GENERATE
MYSQL_PORT=3306
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
NACOS_PORT=8848
NACOS_GRPC_PORT=9848
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Optional middleware. Init appends missing keys without replacing existing values.
ELASTIC_VERSION=8.19.8
ELASTIC_PASSWORD=GENERATE
ELASTIC_PORT=9200
MONGO_VERSION=8.0.17
MONGO_ROOT_USER=devmongo
MONGO_ROOT_PASSWORD=GENERATE
MONGO_PORT=27017
ROCKETMQ_VERSION=5.3.2
ROCKETMQ_NAMESRV_PORT=9876
# Advertised to clients running on Windows. Container clients need a different address.
ROCKETMQ_BROKER_IP=127.0.0.1
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_FAST_PORT=10909
ROCKETMQ_PROXY_REMOTING_PORT=18080
ROCKETMQ_PROXY_GRPC_PORT=18081

# Java full-stack and microservice additions (optional).
NGINX_VERSION=1.28.0
NGINX_PORT=18000
JAVA_APP_PORT=8080
KIBANA_PORT=5601
KIBANA_SYSTEM_PASSWORD=GENERATE
ROCKETMQ_DASHBOARD_VERSION=2.1.0
ROCKETMQ_DASHBOARD_PORT=19876
ROCKETMQ_DASHBOARD_USER=admin
ROCKETMQ_DASHBOARD_PASSWORD=GENERATE
POSTGRES_VERSION=17.7
POSTGRES_PORT=5432
POSTGRES_USER=devpg
POSTGRES_PASSWORD=GENERATE
POSTGRES_DB=dev
MAILPIT_VERSION=1.27.4
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
PROMETHEUS_VERSION=3.5.0
PROMETHEUS_PORT=19090
GRAFANA_VERSION=12.2.0
GRAFANA_PORT=13000
GRAFANA_USER=admin
GRAFANA_PASSWORD=GENERATE
XXL_JOB_VERSION=3.2.0
XXL_JOB_PORT=18082
